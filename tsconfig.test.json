{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "paths": {
      "@neverland-money/address-book": ["./packages/address-book/src"],
      "@neverland-money/contract-helpers": ["./packages/contract-helpers/src"],
      "@neverland-money/contract-types": ["./packages/contract-types/src"],
      "@neverland-money/math-utils": ["./packages/math-utils/src"]
    },
    "target": "es2020",
    "types": ["node", "jest"]
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "packages/*/dist", "packages/*/node_modules"]
}
