{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "paths": {
      "@neverland-money/address-book": ["address-book/src"],
      "@neverland-money/contract-helpers": ["contract-helpers/src"],
      "@neverland-money/contract-types": ["contract-types/src"]
    },
    "target": "es2020"
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "packages/*/dist", "packages/*/node_modules"]
}
