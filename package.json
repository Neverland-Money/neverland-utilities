{
  "name": "@neverland-money/neverland-utilities",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neverland-Money/neverland-utilities.git"
  },
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Utilities for Neverland Lending protocol",
  "keywords": [
    "neverland",
    "lending",
    "defi",
    "monad",
    "addresses",
    "contracts"
  ],
  "author": "Neverland Team",
  "packageManager": "yarn@4.3.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('coverage', { recursive: true, force: true })\" && lerna run clean",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:staged": "lint-staged",
    "check-types": "lerna run check-types",
    "build": "lerna run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "precover": "node -e \"require('node:fs').rmSync('coverage', { recursive: true, force: true })\"",
    "cover": "jest --coverage",
    "commit": "git-cz",
    "release:check": "lerna changed",
    "release:prepared": "lerna publish from-package",
    "release:latest": "NPM_CONFIG_PROVENANCE=true lerna publish --yes --conventional-commits --create-release github --message 'chore(release): publish [ci skip]'",
    "release:canary": "NPM_CONFIG_PROVENANCE=true lerna publish --canary --yes",
    "prepare": "husky install",
    "test:packages": "node --test scripts/workspace-validation.test.mjs scripts/build-sdk-package.test.mjs scripts/sdk-helper-provenance.test.mjs scripts/sdk-provenance-paths.test.mjs scripts/check-buffered-repay-dependency.test.mjs && node scripts/check-packages.mjs",
    "check:sdk-provenance": "node scripts/check-sdk-provenance.mjs",
    "test:sdk-fixtures": "jest --runInBand packages/math-utils/src/math-regression.test.ts packages/math-utils/src/financial-regression.test.ts packages/contract-helpers/src/sdk-compatibility.test.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check-types:fixtures": "node ./node_modules/typescript/bin/tsc -p tsconfig.eslint.json --noEmit",
    "test:validation": "node --test scripts/workspace-validation.test.mjs && node scripts/check-immutable-fixtures.mjs",
    "check:immutable-fixtures": "node scripts/check-immutable-fixtures.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "@commitlint/config-lerna-scopes"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "branch": "main"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/config-lerna-scopes": "^20.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^0.49.0",
    "eslint-config-xo-typescript": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "ethers": "6.17.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-watch-typeahead": "^3.0.1",
    "lerna": "^10.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3",
    "xo": "^1.2.3",
    "yaml": "2.9.0"
  },
  "resolutions": {
    "@eslint/plugin-kit@npm:^0.2.7": "npm:0.3.5",
    "js-yaml@npm:4.3.0": "npm:^4.3.2",
    "pacote@npm:21.0.1": "npm:^21.5.1",
    "undici@npm:7.29.0": "npm:7.30.1",
    "@istanbuljs/load-nyc-config/js-yaml": "npm:^4.3.2",
    "typescript@patch:typescript@npm%3A6.0.3#optional!builtin<compat/typescript>": "npm:6.0.3",
    "handlebars@npm:4.7.9": "npm:4.7.10",
    "ip-address@npm:^10.1.1": "npm:10.7.4",
    "fast-uri@npm:^3.0.1": "npm:3.1.9",
    "undici@npm:^6.25.0": "npm:6.29.1",
    "undici@npm:^8.4.1": "npm:8.12.2"
  }
}
