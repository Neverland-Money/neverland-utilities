{
  "name": "@neverland-money/contract-types",
  "version": "1.1.0",
  "description": "Typed ABIs for Neverland protocol contracts",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "author": "Neverland Team",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "abi-provenance.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "cd ../.. && npx rimraf packages/contract-types/dist packages/contract-types/*.log*",
    "lint": "cd ../.. && eslint packages/contract-types/src/**/*.ts",
    "check-types": "yarn check:abis && cd ../.. && tsc -p packages/contract-types/tsconfig.json --noEmit && tsc -p packages/contract-types/tsconfig.json --module commonjs --noEmit",
    "prebuild": "npm run clean",
    "generate:abis": "node scripts/generate-abis.mjs",
    "check:abis": "node scripts/generate-abis.mjs --check",
    "build": "yarn check:abis && cd ../.. && tsc -p packages/contract-types/tsconfig.json && tsc -p packages/contract-types/tsconfig.json --module commonjs --outDir ./packages/contract-types/dist/cjs",
    "test": "cd ../.. && yarn test packages/contract-types",
    "test:watch": "cd ../.. && yarn test --watch packages/contract-types",
    "cover": "cd ../.. && yarn cover packages/contract-types",
    "commit": "cd ../.. && yarn commit",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "neverland",
    "lending",
    "defi",
    "monad",
    "contracts",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neverland-Money/neverland-utilities.git"
  },
  "dependencies": {
    "abitype": "^1.3.0",
    "tslib": "^2.8.1",
    "viem": "^2.57.3"
  }
}
