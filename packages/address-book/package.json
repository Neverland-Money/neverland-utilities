{
  "name": "@neverland-money/address-book",
  "version": "0.1.0",
  "description": "Address book for Neverland Lending protocol contract addresses",
  "main": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "author": "Neverland Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "cd ../.. && npx rimraf packages/address-book/dist packages/address-book/*.log*",
    "lint": "cd ../.. && eslint packages/address-book/src/**/*.ts",
    "check-types": "yarn build -- --noEmit",
    "prebuild": "npm run clean",
    "build": "cd ../.. && tsc -p packages/address-book/tsconfig.json && tsc -p packages/address-book/tsconfig.json --module commonjs --outDir ./packages/address-book/dist/cjs",
    "test": "cd ../.. && yarn test packages/address-book",
    "test:watch": "cd ../.. && yarn test --watch packages/address-book",
    "cover": "cd ../.. && yarn cover packages/address-book",
    "commit": "cd ../.. && yarn commit",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "neverland",
    "lending",
    "defi",
    "monad",
    "addresses",
    "contracts"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neverland-Money/neverland-utilities.git"
  }
}
