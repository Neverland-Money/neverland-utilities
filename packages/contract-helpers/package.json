{
  "name": "@neverland-money/contract-helpers",
  "version": "0.2.0",
  "description": "Contract helper classes for Neverland protocol",
  "main": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "author": "Neverland Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "cd ../.. && npx rimraf packages/contract-helpers/dist packages/contract-helpers/*.log*",
    "lint": "cd ../.. && eslint packages/contract-helpers/src/**/*.ts",
    "check-types": "yarn build -- --noEmit",
    "prebuild": "npm run clean",
    "build": "cd ../.. && tsc -p packages/contract-helpers/tsconfig.json && tsc -p packages/contract-helpers/tsconfig.json --module commonjs --outDir ./packages/contract-helpers/dist/cjs",
    "test": "cd ../.. && yarn test packages/contract-helpers",
    "test:watch": "cd ../.. && yarn test --watch packages/contract-helpers",
    "cover": "cd ../.. && yarn cover packages/contract-helpers",
    "commit": "cd ../.. && yarn commit",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "neverland",
    "lending",
    "defi",
    "monad",
    "helpers",
    "contracts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neverland-Money/neverland-utilities.git"
  },
  "dependencies": {
    "@neverland-money/contract-types": "^0.2.0",
    "ethers": "^5.7.0"
  },
  "gitHead": "f4f26ca996b40362ed086bac11d5694b0d5dcc09"
}
